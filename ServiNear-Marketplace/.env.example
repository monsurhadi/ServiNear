# ---- Required in production -------------------------------------------------
NODE_ENV=production
# Public HTTPS origin of the website (used for CORS + cookies). Example: https://app.example.com
WEB_ORIGIN=https://app.example.com
# Share cookies between app.example.com and api.example.com (recommended; avoids third-party-cookie blocking)
COOKIE_DOMAIN=.example.com
# First administrator. Password must be 14+ characters. The account is created on first boot.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# ---- Google sign-in ---------------------------------------------------------
# Create an OAuth 2.0 "Web application" client at https://console.cloud.google.com/apis/credentials
# and add your site origin under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ---- Semantic search (real embeddings) ---------------------------------------
# Any provider with an OpenAI-style POST {base}/embeddings endpoint works (OpenAI, Voyage AI, Ollama, LiteLLM...).
# Leave unset to use the built-in keyword/hash vectors. Test Bangla queries before choosing a model.
# EMBEDDING_BASE_URL=https://api.voyageai.com/v1
# EMBEDDING_MODEL=voyage-4
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=            # optional; changing model or dimensions re-embeds everything automatically

# ---- Phone verification (OTP by SMS) ------------------------------------------
# SMS_PROVIDER=twilio              # twilio | bulksmsbd   (console is development-only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                     # or TWILIO_MESSAGING_SERVICE_SID=
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=
REQUIRE_PHONE_VERIFIED=1           # default: on in production. Gates payments, bids and offer acceptance. Payouts always require it.

# ---- Payments (SSLCOMMERZ: bKash, Nagad, Rocket, cards) -----------------------
# PAYMENT_PROVIDER=sslcommerz
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_LIVE=1                # omit to use the sandbox
# PUBLIC_API_URL=https://api.example.com   # the gateway calls back to this address; must be public HTTPS
# MIN_TOPUP_BDT=50
# MAX_TOPUP_BDT=100000

# ---- Optional ---------------------------------------------------------------
PORT=5000
DATA_DIR=./data                 # point at a persistent disk/volume in production
TRUST_PROXY=1                   # set when running behind Render/Nginx so rate limits see real client IPs
SEED_DEMO_DATA=false            # "true" loads demo providers/tasks (never use with real customers)
# GOOGLE_ALLOW_ADMIN=1          # allow admins to use Google sign-in (default: password only)

# ---- Development only (ignored when NODE_ENV=production) ---------------------
# GOOGLE_AUTH_MOCK=1            # lets you test Google sign-in without a client ID
